        "options": {},
        "bodyParametersJson": "={\"mcpVersion\":\"0.1\",\"conversationId\":{{$json.conversationId}},\"sender\":\"n8n\",\"type\":\"task.request\",\"task\":\"run_tests\",\"payload\":{\"job\":\"test-runner\"}}"
      },
